/* ~/.config/waybar/style.css — generado por chezmoi desde .chezmoidata/colors.yaml
   No lo edites en ~/.config: se sobrescribe. Los colores salen de la paleta
   común (./theme.sh la regenera a partir del fondo de escritorio).
   Cápsulas individuales bien separadas (nada agrupado) para no
   equivocarse de clic, salvo el reloj, que despliega acciones rápidas. */

@define-color base     {{ .colors.base }};
@define-color surface0 {{ .colors.surface0 }};
@define-color surface1 {{ .colors.surface1 }};
@define-color overlay0 {{ .colors.overlay0 }};
@define-color subtext0 {{ .colors.subtext0 }};
@define-color text     {{ .colors.text }};
@define-color blue     {{ .colors.accent }};
@define-color lavender {{ .colors.accent3 }};
@define-color mauve    {{ .colors.accent2 }};
@define-color sapphire {{ .colors.sapphire }};
@define-color sky      {{ .colors.sky }};
@define-color teal     {{ .colors.teal }};
@define-color green    {{ .colors.green }};
@define-color yellow   {{ .colors.yellow }};
@define-color peach    {{ .colors.peach }};
@define-color red      {{ .colors.red }};

* {
    font-family: "JetBrainsMono Nerd Font", sans-serif;
    font-size: 13px;
    /* Quita el borde punteado que GTK pinta al enfocar por teclado */
    border: none;
    box-shadow: none;
}

window#waybar {
    background: transparent;
}

/* ---------- Cápsulas ---------- */

#clock-actions,
#custom-agenda,
#custom-weather,
#custom-music,
#workspaces,
#window,
#custom-swaync,
#tray,
#cpu,
#memory,
#custom-network,
#bluetooth,
#pulseaudio,
#pulseaudio-microphone,
#audio,
#power,
#battery {
    background: alpha(@base, 0.85);
    border: 1px solid @surface1;
    border-radius: 999px;
    padding: 0 12px;
    color: @text;
    transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
}

/* Feedback al pasar el ratón: todos estos módulos son clicables y antes
   no daban ninguna señal de serlo. */
#custom-weather:hover,
#custom-agenda:hover,
#custom-swaync:hover,
#cpu:hover,
#memory:hover,
#custom-network:hover,
#bluetooth:hover,
#pulseaudio:hover,
#pulseaudio-microphone:hover,
#custom-music:hover,
#audio:hover,
#power:hover,
#battery:hover {
    background: alpha(@surface0, 0.95);
    border-color: @blue;
}

/* ---------- Reproductor ---------- */

#custom-music {
    margin-left: 6px;
    color: @teal;
}

#custom-music.paused {
    color: @overlay0;
    font-style: italic;
}

/* ---------- Workspaces ---------- */

#workspaces {
    padding: 0 4px;
}

#workspaces button {
    padding: 0 9px;
    margin: 4px 2px;
    border-radius: 999px;
    color: @overlay0;
    background: transparent;
    font-size: 14px;
    transition: all 200ms ease;
}

#workspaces button:hover {
    color: @text;
    background: alpha(@blue, 0.18);
}

#workspaces button.active {
    color: @base;
    background: @blue;
}

#workspaces button.urgent {
    color: @base;
    background: @red;
}

/* ---------- Título de la ventana enfocada ---------- */

#window {
    color: @subtext0;
    font-style: italic;
    background: alpha(@base, 0.6);
    border-color: @surface0;
}

/* Sin ventana enfocada: que no quede una cápsula vacía flotando */
window#waybar.empty #window {
    background: transparent;
    border-color: transparent;
    color: @overlay0;
}

/* ---------- Sliders desplegables (volumen y brillo) ---------- */

#audio,
#power {
    padding: 0 4px;
}

#audio:hover,
#power:hover {
    border-color: @lavender;
}

/* Los módulos van dentro de la cápsula del grupo: sin fondo ni borde. */
#audio #pulseaudio,
#power #battery {
    background: transparent;
    border: none;
    padding: 0 8px;
}

#pulseaudio-slider,
#backlight-slider {
    min-width: 110px;
    margin: 0 8px 0 4px;
}

#pulseaudio-slider trough,
#backlight-slider trough {
    min-height: 6px;
    border-radius: 999px;
    background: @surface1;
}

#pulseaudio-slider highlight {
    border-radius: 999px;
    background: @sky;
}

#backlight-slider highlight {
    border-radius: 999px;
    background: @yellow;
}

#pulseaudio-slider slider,
#backlight-slider slider {
    min-width: 12px;
    min-height: 12px;
    border-radius: 999px;
    background: @text;
}

/* ---------- Agenda ---------- */

#custom-agenda {
    margin-right: 6px;
    color: @lavender;
}

/* Sin eventos a la vista el módulo imprime texto vacío: sin este padding a
   cero quedaría una cápsula fantasma en mitad de la barra. */
#custom-agenda.empty {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

#custom-agenda.soon {
    color: @peach;
    border-color: alpha(@peach, 0.5);
}

/* Evento en curso: mismo tratamiento que .soon (texto y borde teñidos). El
   relleno sólido verde cantaba demasiado en mitad de la barra. */
#custom-agenda.live {
    color: @green;
    border-color: alpha(@green, 0.5);
}

/* ---------- Reloj + acciones rápidas (drawer) ---------- */
#clock-actions {
    padding: 0 4px;
}

#clock-actions:hover {
    border-color: @lavender;
}

/* El reloj y los pills viven DENTRO de la cápsula del grupo, así que no
   llevan fondo ni borde propios. */
#clock-actions #custom-clock {
    background: transparent;
    border: none;
    padding: 0 10px;
    font-weight: bold;
    color: @text;
}

/* Se listan también los ids: la clase "children-class" del drawer se aplica
   al contenedor del módulo, no siempre al widget que pinta el padding, y sin
   los ids los pills salían pegados unos a otros. */
.quick-action,
#custom-screenshot,
#custom-screenshot-full,
#custom-colorpicker,
#custom-caffeine,
#custom-dnd,
#custom-lock,
#custom-power {
    background: transparent;
    border: none;
    border-radius: 999px;
    margin: 3px 1px;
    padding: 0 8px;
    font-size: 15px;
    color: @subtext0;
    transition: all 200ms ease;
}

.quick-action:hover,
#custom-screenshot:hover,
#custom-screenshot-full:hover,
#custom-colorpicker:hover,
#custom-caffeine:hover,
#custom-dnd:hover,
#custom-lock:hover,
#custom-power:hover {
    background: alpha(@lavender, 0.20);
    color: @text;
}

#custom-screenshot:hover      { color: @sapphire; }
#custom-screenshot-full:hover { color: @sapphire; }
#custom-colorpicker:hover     { color: @mauve; }
#custom-lock:hover            { color: @blue; }
#custom-dnd:hover             { color: @peach; }
#custom-power:hover           { color: @red; }

#custom-caffeine.active {
    color: @yellow;
}

#custom-dnd.active {
    color: @peach;
}

/* ---------- Acentos por módulo ---------- */

#custom-weather        { color: @sapphire; }
/* El icono cambia de color con la condición del cielo. */
#custom-weather.clear   { color: @yellow; }
#custom-weather.partly  { color: @peach; }
#custom-weather.cloud   { color: @subtext0; }
#custom-weather.fog     { color: @overlay0; }
#custom-weather.rain    { color: @sapphire; }
#custom-weather.sleet,
#custom-weather.snow    { color: @sky; }
#custom-weather.storm   { color: @mauve; }
#custom-weather.stale,
#custom-weather.offline { color: @overlay0; }
#cpu                   { color: @peach; }
#memory                { color: @green; }
#custom-network        { color: @blue; }
#bluetooth             { color: @sapphire; }
#pulseaudio            { color: @lavender; }
#pulseaudio-microphone { color: @teal; }
#battery               { color: @green; }
#custom-swaync         { color: @yellow; }

/* ---------- Estados ---------- */

#bluetooth.disabled,
#bluetooth.off {
    color: @overlay0;
}

#battery.warning  { color: @yellow; }
#battery.critical { color: @red; }
#battery.charging { color: @teal; }
#battery.plugged  { color: @green; }

/* Con la VPN levantada el icono lleva candado y cambia de color. */
#custom-network.vpn { color: @green; }

#pulseaudio.muted,
#pulseaudio-microphone.muted {
    color: @overlay0;
}

#tray menu {
    background: @base;
    border: 1px solid @surface1;
    border-radius: 10px;
    color: @text;
}

/* ---------- Tooltips ---------- */

tooltip {
    background: @base;
    border: 1px solid @surface1;
    border-radius: 10px;
}

tooltip label {
    color: @text;
    padding: 6px;
}
