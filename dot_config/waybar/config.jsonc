// ~/.config/waybar/config.jsonc
// Versión simplificada: bonita pero estable. Módulos individuales bien
// separados (nada agrupado/apretado) para evitar clics equivocados.
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": [
        "ext/workspaces",
        "hyprland/window",
        "custom/music"
    ],
    "modules-center": [
        "group/clock-actions"
    ],
    "modules-right": [
        "custom/weather",
        "custom/swaync",
        "tray",
        "cpu",
        "memory",
        "custom/network",
        "bluetooth",
        "group/audio",
        "pulseaudio#microphone",
        "group/power"
    ],

    // Al pasar el ratón por el reloj se despliegan las acciones rápidas.
    // El primer módulo del grupo es el único visible en reposo; el resto
    // aparece deslizando hacia la derecha.
    // El grupo NO puede llamarse "clock": su caja CSS sería #clock y
    // chocaría con el módulo del reloj que lleva dentro.
    "group/clock-actions": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 350,
            "children-class": "quick-action",
            "transition-left-to-right": true
        },
        "modules": [
            "clock",
            "custom/screenshot",
            "custom/screenshot-full",
            "custom/colorpicker",
            "custom/caffeine",
            "custom/dnd",
            "custom/lock",
            "custom/power"
        ]
    },

    // Al pasar el ratón por el volumen o por la batería se despliega el
    // slider correspondiente hacia la izquierda.
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 350,
            "children-class": "slider-action",
            "transition-left-to-right": false
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "group/power": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 350,
            "children-class": "slider-action",
            "transition-left-to-right": false
        },
        "modules": [
            "battery",
            "backlight/slider"
        ]
    },

    // min 1: a 0 la pantalla se queda negra y no hay forma de volver.
    "backlight/slider": {
        "min": 1,
        "max": 100,
        "orientation": "horizontal"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true,
        "rewrite": {
            "": "Escritorio"
        }
    },

    "custom/screenshot": {
        "format": "󰒅",
        "tooltip": true,
        "tooltip-format": "Capturar una región → portapapeles",
        "on-click": "grim -g \"$(slurp)\" - | wl-copy"
    },
    "custom/screenshot-full": {
        "format": "󰄀",
        "tooltip": true,
        "tooltip-format": "Capturar la pantalla entera → ~/Pictures",
        "on-click": "grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png"
    },
    "custom/colorpicker": {
        "format": "󰈊",
        "tooltip": true,
        "tooltip-format": "Cuentagotas de color → portapapeles",
        "on-click": "hyprpicker -a"
    },
    "custom/caffeine": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/caffeine.sh --status",
        "interval": 30,
        // El script hace pkill -RTMIN+8 waybar para refrescar al instante
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/caffeine.sh"
    },
    "custom/dnd": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/dnd.sh --status",
        "interval": 30,
        "signal": 10,
        "on-click": "~/.config/hypr/scripts/dnd.sh"
    },
    "custom/lock": {
        "format": "󰌾",
        "tooltip": true,
        "tooltip-format": "Bloquear la sesión",
        "on-click": "~/.local/share/quickshell-lockscreen/lock.sh"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Apagar, reiniciar, cerrar sesión…",
        "on-click": "wlogout -b 5"
    },
    // Cápsula del reproductor: se esconde sola tras 5 minutos en pausa.
    "custom/music": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/music.sh",
        "interval": 2,
        "escape": true,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl position 5+",
        "on-scroll-down": "playerctl position 5-"
    },
    "clock": {
        "format": "{:%H:%M  %d/%m}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "gnome-calendar",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#d4d4d8'><b>{}</b></span>",
                "days": "<span color='#a1a1aa'>{}</span>",
                "weekdays": "<span color='#71717a'><b>{}</b></span>",
                "today": "<span color='#b34747'><b><u>{}</u></b></span>"
            }
        }
    },
    "custom/weather": {
        "format": "{}",
        "on-click": "xdg-open https://wttr.in/Madrid",
        "interval": 3600,
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/Weather.py",
        "exec-if": "ping wttr.in -c1",
        "tooltip": true
    },
    // Se usa "ext/workspaces" (protocolo ext-workspace-v1) y NO
    // "hyprland/workspaces": este último manda por IPC la sintaxis vieja
    // ("dispatch workspace 3"), que la config en Lua de Hyprland 0.55+
    // ya no parsea, y por eso los clics dejaron de cambiar de workspace.
    // El módulo ext/ activa el workspace vía protocolo Wayland, sin hyprctl.
    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        // Por nombre, no por id: Hyprland no manda id en este protocolo y
        // "sort-by-id" dejaba los workspaces en orden de creación (1 3 2 10 8).
        // Waybar solo ordena numéricamente si TODOS los nombres son dígitos, y
        // el scratchpad ("special:quake") lo impide; por eso hyprland.lua nombra
        // los workspaces "01".."10": así el orden alfabético ya es el numérico.
        "sort-by-name": true,
        "all-outputs": true,
        // Mismo esquema que las reglas de workspace de hyprland.lua.
        // OJO: no definir "active" aquí — sobreescribiría el icono propio
        // del workspace activo. El estado activo se marca por CSS.
        "format-icons": {
            "01": "󰈹",
            "02": "󰨞",
            "03": "󰭹",
            "04": "󰉋",
            "05": "󰠮",
            "06": "󰝚",
            "07": "󰊴",
            "08": "󰏘",
            "09": "󰒓",
            "10": "󰇙",
            "default": "󰝥"
        }
    },
    "custom/swaync": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='#b34747'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='#b34747'><sup></sup></span>",
            "dnd-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    
    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "on-click": "~/.config/hypr/scripts/proc-menu.sh cpu",
        "on-click-middle": "kitty -e btop"
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 2,
        "on-click": "~/.config/hypr/scripts/proc-menu.sh mem",
        "on-click-middle": "kitty -e btop"
    },
    // Reemplaza al módulo "network" nativo: este sí sabe de la VPN.
    "custom/network": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/net-status.sh",
        "interval": 5,
        "signal": 9,
        // Menú de redes y VPN al alcance, anclado bajo el módulo (rofi).
        "on-click": "~/.config/hypr/scripts/wifi-menu.sh",
        "on-click-middle": "~/.config/hypr/scripts/wifi-menu.sh",
        "on-click-right": "~/.config/hypr/scripts/net-status.sh --toggle"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": " {num_connections}",
        "tooltip-format": "{controller_alias}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": " {device_alias}",
        "on-click": "~/.config/hypr/scripts/bluetooth-menu.sh",
        "on-click-middle": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "scroll-step": 5,
        // Selector de dispositivo de salida; el mezclador completo queda
        // en la última entrada del menú y en el clic central.
        "on-click": "~/.config/hypr/scripts/audio-menu.sh output",
        "on-click-middle": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
        "tooltip-format": "{desc} | {volume}%"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " muted",
        "on-click": "~/.config/hypr/scripts/audio-menu.sh input",
        "on-click-middle": "pavucontrol --tab=4",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
        "scroll-step": 5,
        "tooltip-format": "{source_desc} | {source_volume}%"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " 100%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "format-time": "{H}h {M}min",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl -n set 1%-",
        "tooltip": true,
        "tooltip-format": "{timeTo} · {power:.1f}W",
        "on-click": "~/.config/hypr/scripts/power-menu.sh",
        "on-click-right": "~/.config/hypr/scripts/caffeine.sh"
    }
}
