------------------
---- MONITORES ----
------------------
hl.monitor({
    output   = "",
    mode     = "preferred",
    position = "auto",
    scale    = 1,
})


---------------------------
---- PROGRAMAS POR DEFECTO ----
---------------------------
local terminal    = "kitty"
local fileManager = "thunar"
local menu        = "rofi -show drun"
local lockscreen  = "~/.local/share/quickshell-lockscreen/lock.sh"


-------------------
---- AUTOSTART ----
-------------------
hl.on("hyprland.start", function()
    hl.exec_cmd("waybar")
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("swaync")
    hl.exec_cmd("hypridle")
    -- Vigilantes del portapapeles: alimentan el historial de cliphist.
    hl.exec_cmd("wl-paste --type text --watch cliphist store")
    hl.exec_cmd("wl-paste --type image --watch cliphist store")
    -- Baja el brillo y avisa cuando la batería llega al 15%.
    hl.exec_cmd(os.getenv("HOME") .. "/.config/hypr/scripts/battery-watch.sh")
    -- Descomenta si prefieres KWallet en vez de gnome-keyring:
    -- hl.exec_cmd("/usr/lib/kwalletd6")
end)


