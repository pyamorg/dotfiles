---- Asignación de apps a workspaces ----
-- Esquema (los mismos iconos están en waybar/config.jsonc → format-icons):
--   1 󰈹 Web · 2 󰨞 Código · 3 󰭹 Comunicación · 4 󰉋 Archivos · 5 󰠮 Notas
--   6 󰝚 Música · 7 󰊴 Juegos · 8 󰏘 Diseño · 9 󰒓 Sistema · 10 󰇙 Varios
-- Los tres primeros son el día a día (firefox / code / teams) y son
-- persistentes: siempre aparecen en la barra aunque estén vacíos.
-- Para añadir más apps: ábrela, corre "hyprctl clients -j | jq .[].class".
-- OJO: los patrones de "match" son regex ECMAScript (no patrones de Lua),
-- por eso los puntos se escapan con "\\." y no con "%.".
local ws_apps = {
    ["1"]  = { "firefox", "firefox-esr", "chromium", "Google-chrome", "zen" },
    ["2"]  = { "code-oss", "Code", "VSCodium", "Cursor", "jetbrains-.*" },
    ["3"]  = { "teams-for-linux", "Slack", "discord", "vesktop",
               "org\\.telegram\\.desktop", "Element", "org\\.mozilla\\.Thunderbird" },
    ["4"]  = { "thunar", "org\\.gnome\\.Nautilus", "nemo" },
    ["5"]  = { "Joplin", "obsidian", "com\\.github\\.flxzt\\.rnote" },
    ["6"]  = { "feishin", "[Ss]potify", "io\\.bassi\\.Amberol" },
    ["7"]  = { "steam", "steam_app_.*", "lutris", "com\\.heroicgameslauncher\\.hgl" },
    ["8"]  = { "gimp.*", "org\\.inkscape\\.Inkscape", "krita", "blender" },
    ["9"]  = { "org\\.pulseaudio\\.pavucontrol", "nm-connection-editor",
               "blueman-manager", "org\\.gnome\\.SystemMonitor", "qt[56]ct" },
}

for ws, classes in pairs(ws_apps) do
    for _, class in ipairs(classes) do
        hl.window_rule({
            name      = "ws" .. ws .. "-" .. class:gsub("[^%w]", ""),
            match     = { class = "^(" .. class .. ")$" },
            workspace = ws,
        })
    end
end

---- Comportamiento por workspace ----
-- Nombres con dos dígitos ("01".."10"). El módulo ext/workspaces de waybar
-- solo ordena numéricamente si TODOS los nombres son dígitos, y el scratchpad
-- ("special:quake") lo impide: cae a orden alfabético y el 10 acababa entre
-- el 1 y el 2. Con el cero delante el orden alfabético ya es el numérico.
for i = 1, 10 do
    hl.workspace_rule({
        workspace    = tostring(i),
        default_name = string.format("%02d", i),
    })
end

-- 1-3 persistentes para que la barra no "baile" al cerrar la última ventana.
hl.workspace_rule({ workspace = "1", persistent = true })
hl.workspace_rule({ workspace = "3", persistent = true })

-- Workspace 2 (código): persistente + layout master. La primera ventana de
-- Code se queda grande a la izquierda y las siguientes se apilan a la
-- derecha, en vez de partir el espacio a la mitad cada vez como hace dwindle.
hl.workspace_rule({
    workspace   = "2",
    persistent  = true,
    layout      = "master",
    layout_opts = { orientation = "left" },
})

