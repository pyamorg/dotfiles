-- rofi/waybar/swaync son superficies layer-shell, no ventanas normales:
-- necesitan layer_rule para el blur, no window_rule.
hl.layer_rule({ name = "blur-rofi",       match = { namespace = "^rofi$" },   blur = true, ignore_alpha = 0.5 })
-- Sin ignore_alpha, waybar difumina TODA la franja de la barra, tambien los
-- huecos transparentes entre pills; con el umbral solo se difumina lo opaco.
hl.layer_rule({ name = "blur-waybar",     match = { namespace = "^waybar$" }, blur = true, ignore_alpha = 0.5 })
hl.layer_rule({ name = "blur-swaync-notif",   match = { namespace = "^swaync-notification-window$" }, blur = true, ignore_alpha = 0.6 })
hl.layer_rule({ name = "blur-swaync-control", match = { namespace = "^swaync-control-center$" },      blur = true, ignore_alpha = 0.6 })


----------------------------------------
---- CERRAR ROFI AL CLICAR FUERA ----
----------------------------------------
-- En Wayland rofi no recibe los clics que caen fuera de su superficie, asi
-- que su "click-to-exit" nunca dispara. Se suple desde el compositor con
-- binds no consumidores: el clic sigue llegando a quien toque.
local function close_rofi_on_outside_click()
    local layers = hl.get_layers({ namespace = "rofi" })
    if not layers or #layers == 0 then return end

    local pos = hl.get_cursor_pos()
    if not pos then return end

    for _, layer in ipairs(layers) do
        if pos.x >= layer.x and pos.x <= layer.x + layer.w
            and pos.y >= layer.y and pos.y <= layer.y + layer.h then
            return
        end
    end

    hl.exec_cmd("pkill -x rofi")
end

for _, button in ipairs({ "mouse:272", "mouse:273", "mouse:274" }) do
    hl.bind(button, close_rofi_on_outside_click, { mouse = true, non_consuming = true })
end

-- HyprMod managed settings. Con pcall para que un fichero borrado o a medio
-- escribir por la GUI no tumbe el resto de la configuración.
pcall(require, "hyprland-gui")
