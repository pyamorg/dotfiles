## ~/.config/hypr/hyprlock.conf — generado por chezmoi desde .chezmoidata/colors.yaml

background {
    monitor =
    color = rgba({{ trimPrefix "#" .colors.crust }}ff)   # fondo simple, sin depender de captura de pantalla
    blur_passes = 0
}

input-field {
    monitor =
    size = 280, 60
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.3
    outer_color = rgba({{ trimPrefix "#" .colors.accent }}ff)
    inner_color = rgba({{ trimPrefix "#" .colors.base }}d9)
    font_color = rgba({{ trimPrefix "#" .colors.text }}ff)
    fade_on_empty = true
    placeholder_text = <i>Contraseña...</i>
    hide_input = false
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = rgba({{ trimPrefix "#" .colors.text }}ff)
    font_size = 64
    font_family = JetBrainsMono Nerd Font
    position = 0, 120
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] echo "$(date +"%A, %d de %B")"
    color = rgba({{ trimPrefix "#" .colors.subtext0 }}ff)
    font_size = 18
    font_family = JetBrainsMono Nerd Font
    position = 0, 60
    halign = center
    valign = center
}
