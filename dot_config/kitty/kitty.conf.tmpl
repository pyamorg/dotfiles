## ~/.config/kitty/kitty.conf

# Evita el popup "¿cerrar esta ventana?" cuando hay un proceso
# (como btop) corriendo en primer plano.
confirm_os_window_close 0

font_family JetBrainsMono Nerd Font
font_size 11.0
#background_opacity 0.92
background_opacity 0.8

#####################
### COLORES — generados por chezmoi desde .chezmoidata/colors.yaml
#####################
# Los 16 ANSI salen de la paleta común: así la terminal va a juego con
# waybar, rofi y el resto del escritorio sin tocar nada a mano.

foreground {{ .colors.text }}
background {{ .colors.base }}
selection_foreground {{ .colors.base }}
selection_background {{ .colors.accent }}
color0 {{ .colors.surface1 }}
color1 {{ .colors.red }}
color2 {{ .colors.green }}
color3 {{ .colors.yellow }}
color4 {{ .colors.accent }}
color5 {{ .colors.accent2 }}
color6 {{ .colors.teal }}
color7 {{ .colors.subtext0 }}
color8 {{ .colors.overlay0 }}
color9 {{ .colors.red }}
color10 {{ .colors.green }}
color11 {{ .colors.peach }}
color12 {{ .colors.accent3 }}
color13 {{ .colors.pink }}
color14 {{ .colors.sky }}
color15 {{ .colors.text }}

# URL styles
url_color {{ .colors.accent2 }}
url_style single

# Cursor styles
cursor {{ .colors.accent }}

# START_AUTOGENERATED_TAB_STYLE
# Feel free to update these colors manually and remove these comments.
active_tab_foreground   #eeeeee
active_tab_background   #00d5eb
inactive_tab_foreground #ffffff
inactive_tab_background #0a0c27
# END_AUTOGENERATED_TAB_STYLE