/* ~/.config/swaync/style.css — generado por chezmoi desde .chezmoidata/colors.yaml */
/* Tema "nova-dark" de JaKooLit/Hyprland-Dots. La transparencia del panel
   viene de fábrica en el propio tema vía alpha(@background, .55) — sólo hay
   que definir bien estas variables. */

@define-color background     {{ .colors.base }};
@define-color background-sec {{ .colors.surface0 }};
@define-color foreground     {{ .colors.text }};
@define-color color1         {{ .colors.surface1 }};
@define-color color2         {{ .colors.red }};
@define-color color3         {{ .colors.overlay0 }};
@define-color color5         {{ .colors.yellow }};
@define-color color6         {{ .colors.subtext0 }};

@import 'themes/nova-dark/notifications.css';
@import 'themes/nova-dark/central_control.css';
