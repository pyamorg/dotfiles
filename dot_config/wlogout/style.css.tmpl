/* ~/.config/wlogout/style.css — generado por chezmoi desde .chezmoidata/colors.yaml */

@define-color base     {{ .colors.base }};
@define-color surface0 {{ .colors.surface0 }};
@define-color surface1 {{ .colors.surface1 }};
@define-color text     {{ .colors.text }};
@define-color accent   {{ .colors.accent }};

* {
    font-family: "JetBrainsMono Nerd Font", sans-serif;
}

window {
    background-color: alpha(@base, 0.75);
}

button {
    color: @text;
    background-color: @surface0;
    border-style: solid;
    border-width: 2px;
    border-color: @surface1;
    border-radius: 16px;
    margin: 10px;
    font-size: 16px;

    /* Los iconos se pintan como background-image. GTK3 NO soporta
       ::before ni la propiedad content (no es CSS web), que es como
       estaban antes y por eso no se renderizaba ninguno. */
    background-repeat: no-repeat;
    background-position: center 30%;
    background-size: 44px;
    padding-top: 54px;
}

button:hover {
    background-color: @surface1;
    border-color: @accent;
}

button:focus {
    background-color: @accent;
    color: @base;
    border-color: @accent;
}

/* PNG y no SVG a propósito: librsvg ya no instala el loader de
   gdk-pixbuf, así que GTK no sabe rasterizar SVG. Los .svg se quedan
   como fuente editable y se regeneran con:
     rsvg-convert -w 128 -h 128 icono.svg -o icono.png  */
#lock     { background-image: image(url("icons/lock.png")); }
#logout   { background-image: image(url("icons/logout.png")); }
#suspend  { background-image: image(url("icons/suspend.png")); }
#reboot   { background-image: image(url("icons/reboot.png")); }
#shutdown { background-image: image(url("icons/shutdown.png")); }

